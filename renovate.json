{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>muhlba91/renovate-config",
    "github>muhlba91/renovate-config:automerge(patch)",
    "github>muhlba91/renovate-config:automerge(minor)"
  ],
  "enabledManagers": [
    "github-actions",
    "pre-commit",
    "dockerfile",
    "custom.regex",
    "mise"
  ],
  "customManagers": [
    {
      "description": "versions annotated with a renovate comment in the Dockerfile, workflows and README",
      "customType": "regex",
      "managerFilePatterns": [
        "/^Dockerfile$/",
        "/^\\.github/workflows/.+\\.yml$/",
        "/^README\\.md$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) packageName=(?<packageName>\\S+)(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\s+(?:ARG )?[\\w.-]+[:=] ?[\"']?(?:[^:\\s\"']+:)?(?<currentValue>[^\\s\"']+)[\"']?"
      ]
    }
  ]
}
